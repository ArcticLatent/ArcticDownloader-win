{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "Arctic ComfyUI Helper",
    "version":  "0.2.2",
    "identifier":  "io.github.ArcticHelper",
    "build":  {
                  "frontendDist":  "dist"
              },
    "app":  {
                "withGlobalTauri":  true,
                "windows":  [
                                {
                                    "title":  "Arctic ComfyUI Helper",
                                    "width":  1240,
                                    "height":  860,
                                    "resizable":  true
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "publisher":  "Arctic Latent",
                   "icon":  [
                                "icons/favicon.ico"
                            ],
                   "targets":  "all"
               }
}